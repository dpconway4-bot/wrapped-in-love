{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.2.22"
    }
  },
  "crons": [
    {
      "path": "/api/weekly-report",
      "schedule": "0 12 * * 1"
    }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook.ts" },
    { "src": "/api/journal/([^/]+)", "dest": "/api/journal/[day].ts" },
    { "src": "/api/admin/post-queue", "dest": "/api/admin-post-queue.ts" },
    { "src": "/api/admin/engagement-queue", "dest": "/api/admin-engagement-queue.ts" },
    { "src": "/api/admin/history", "dest": "/api/admin-history.ts" },
    { "src": "/api/(.*)", "dest": "/api/$1.ts" },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|otf|mp3|wav|json|txt|xml))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
